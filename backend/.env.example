# Example environment configuration template
# Copy this file to .env and fill in your actual values:
# cp .env.example .env

# Local development:
DB_URL=jdbc:postgresql://localhost:5432/shareit_db
# Cloud production (Render, Supabase, Neon):
# DB_URL=jdbc:postgresql://dpg-xxxx.render.com:5432/shareit_db?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here
JWT_SECRET=your_base64_encoded_jwt_secret_here
SERVER_PORT=8080

# Cloudinary Cloud Image Storage (Free cloud storage for images):
CLOUDINARY_CLOUD_NAME=ti1pdknj
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
